{
  // SoundFace API on Cloudflare Workers. Not deployed yet: deployment needs the
  // owner's Cloudflare account, a Workers Paid plan (email sending) and a domain
  // hosted on Cloudflare. Local development: `npm run dev` (see README.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soundface-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    // database_id is filled in when the owner creates the database (`wrangler d1 create soundface`).
    { "binding": "DB", "database_name": "soundface", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "durable_objects": { "bindings": [{ "name": "ACCOUNTS", "class_name": "AccountObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountObject"] }],
  // Arbitrary recipients need an onboarded sending domain; `wrangler dev` only simulates sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Safe production defaults. Development overrides live in .dev.vars (see .dev.vars.example).
    "DEV_LOGIN": "0",
    "PROVIDER": "fake",
    "ALLOW_PAID": "0",
    "MAIL_FROM": "",
    "TRIAL_SECONDS": "0",
    "HEARTBEAT_TIMEOUT_MS": "30000"
  }
}
