{
  "name": "soundface",
  "productName": "SoundFace",
  "version": "0.1.0",
  "private": true,
  "description": "SoundFace macOS development app",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:audio": "bash scripts/build-audio.sh && bash scripts/build-bridge.sh",
    "build:camera": "bash scripts/build-camera.sh",
    "build": "npm run build:audio && npm run build:camera && node scripts/package.cjs",
    "test": "bash scripts/test-camera.sh && node --test tests/*.test.cjs && bash scripts/test-ring.sh && bash scripts/test-resampler.sh",
    "verify:package": "node scripts/verify-package.cjs",
    "server": "SOUNDFACE_DEV_LOGIN=1 node server/index.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2"
  }
}
